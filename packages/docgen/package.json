{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/docgen",
	"version": "0.12.1",
	"private": true,
	"description": "The docs.json generator for discord.js and its related projects",
	"keywords": [
		"discordjs",
		"docgen",
		"docs",
		"docsgen",
		"documentation",
		"generator",
		"node"
	],
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "Apache-2.0",
	"contributors": [
		"Crawl <icrawltogo@gmail.com>",
		"Amish Shah <amishshah.2k@gmail.com>",
		"Schuyler Cebulskie <Gawdl3y@Gawdl3y.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/docgen"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"bin": "./bin/index.js",
	"directories": {
		"lib": "src",
		"bin": "bin"
	},
	"files": [
		"bin/index.js",
		"dist"
	],
	"main": "./dist/src/index.js",
	"module": "./dist/src/index.mjs",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"import": {
				"types": "./dist/src/index.d.mts",
				"default": "./dist/src/index.mjs"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions",
		"fmt": "pnpm run format",
		"prepack": "pnpm run format && pnpm run build"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"jsdoc-to-markdown": "^8.0.3",
		"tslib": "^2.8.1",
		"typedoc": "^0.25.13"
	},
	"devDependencies": {
		"@types/jsdoc-to-markdown": "^7.0.6",
		"@types/node": "^24.13.3",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"terser": "^5.51.2",
		"tsup": "^8.5.1",
		"turbo": "^2.10.12",
		"typescript": "~5.9.3"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
