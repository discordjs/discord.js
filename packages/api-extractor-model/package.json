{
	"name": "@discordjs/api-extractor-model",
	"version": "7.33.8",
	"private": true,
	"description": "A helper library for loading and saving the .api.json files created by API Extractor",
	"homepage": "https://discord.js.org",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/api-extractor-model"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsc --noEmit && tsup",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions"
	},
	"dependencies": {
		"@microsoft/tsdoc": "~0.16.0",
		"@microsoft/tsdoc-config": "~0.18.1",
		"@rushstack/node-core-library": "5.23.1"
	},
	"devDependencies": {
		"@types/node": "^24.13.2",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"terser": "^5.46.1",
		"tsup": "^8.5.1",
		"turbo": "^2.8.21",
		"typescript": "~5.9.3"
	}
}
