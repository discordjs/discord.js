{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/rpc",
	"version": "0.1.0",
	"description": "A simple RPC client for Discord",
	"keywords": [
		"discord",
		"remote procedural call",
		"rich presence",
		"rpc"
	],
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "MIT",
	"contributors": [
		"Crawl <icrawltogo@gmail.com>",
		"SpaceEEC <spaceeec@yahoo.com>",
		"Vlad Frangu <me@vladfrangu.dev>",
		"Aura Román <kyradiscord@gmail.com>",
		"Micah Benac <micahbenac52@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/rpc"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc --noEmit && tsup",
		"build:docs": "tsc -p tsconfig.docs.json",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions",
		"fmt": "pnpm run format",
		"docs": "pnpm run build:docs && api-extractor run --local --minify && generate-split-documentation",
		"prepack": "pnpm run build && pnpm run lint",
		"changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r ../../ --include-path 'packages/rpc/*'",
		"release": "cliff-jumper"
	},
	"dependencies": {
		"@vladfrangu/async_event_emitter": "^2.4.7",
		"discord-api-types": "^0.38.54"
	},
	"devDependencies": {
		"@discordjs/api-extractor": "workspace:^",
		"@discordjs/scripts": "workspace:^",
		"@favware/cliff-jumper": "^6.1.0",
		"@types/node": "^24.13.3",
		"esbuild-plugin-version-injector": "^1.2.1",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"tsup": "^8.5.1",
		"turbo": "^2.10.12",
		"typescript": "~5.9.3"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
