{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/proxy",
	"version": "2.1.1",
	"description": "Tools for running an HTTP proxy for Discord's API",
	"keywords": [
		"api",
		"discord",
		"discordapp",
		"discordjs",
		"proxy",
		"rest"
	],
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "Apache-2.0",
	"contributors": [
		"Crawl <icrawltogo@gmail.com>",
		"Amish Shah <amishshah.2k@gmail.com>",
		"SpaceEEC <spaceeec@yahoo.com>",
		"Vlad Frangu <me@vladfrangu.dev>",
		"Aura Román <kyradiscord@gmail.com>",
		"DD <didinele.dev@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/proxy"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"directories": {
		"lib": "src",
		"test": "__tests__"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest run --config ../../vitest.config.ts",
		"build": "tsc --noEmit && tsup",
		"build:docs": "tsc -p tsconfig.docs.json",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src __tests__",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src __tests__ --fix --fix-suggestions",
		"fmt": "pnpm run format",
		"docs": "pnpm run build:docs && api-extractor run --local --minify && generate-split-documentation",
		"prepack": "pnpm run lint && pnpm run test && pnpm run build",
		"changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r ../../ --include-path 'packages/proxy/*'",
		"release": "cliff-jumper"
	},
	"dependencies": {
		"@discordjs/rest": "workspace:^",
		"@discordjs/util": "workspace:^",
		"tslib": "^2.8.1",
		"undici": "7.24.6"
	},
	"devDependencies": {
		"@discordjs/api-extractor": "workspace:^",
		"@discordjs/scripts": "workspace:^",
		"@favware/cliff-jumper": "^6.0.0",
		"@types/node": "^24.13.2",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.1.2",
		"esbuild-plugin-version-injector": "^1.2.1",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"supertest": "^7.2.2",
		"tsup": "^8.5.1",
		"turbo": "^2.8.21",
		"typescript": "~5.9.3",
		"vitest": "^4.1.2"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
