{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/api-extractor-utils",
	"version": "1.0.0",
	"private": true,
	"description": "Utilities for api-extractor",
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "Apache-2.0",
	"contributors": [
		"Suneet Tipirneni <suneettipirneni@icloud.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/api-extractor-utils"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsc --noEmit && tsup",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions",
		"fmt": "pnpm run format"
	},
	"dependencies": {
		"@discordjs/api-extractor-model": "workspace:^",
		"@microsoft/tsdoc": "~0.16.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.2",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"terser": "^5.46.1",
		"tsup": "^8.5.1",
		"turbo": "^2.8.21",
		"typescript": "~5.9.3"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
