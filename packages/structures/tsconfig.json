{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../tsconfig.base.json",
	"include": ["src/**/*.ts", "src/**/*.js", "src/**/*.cjs", "src/**/*.mjs", "bin"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"experimentalDecorators": false,
		"types": ["node"],
		"rootDir": "./src"
	}
