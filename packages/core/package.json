{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/core",
	"version": "2.1.0",
	"description": "A thinly abstracted wrapper around the rest API, and gateway.",
	"keywords": [],
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "Apache-2.0",
	"contributors": [
		"Crawl <icrawltogo@gmail.com>",
		"SpaceEEC <spaceeec@yahoo.com>",
		"Vlad Frangu <me@vladfrangu.dev>",
		"Aura Román <kyradiscord@gmail.com>",
		"Suneet Tipirneni <suneettipirneni@icloud.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/core"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./http-only": {
			"types": "./dist/http-only/index.d.ts",
			"default": "./dist/http-only/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest run --config ../../vitest.config.ts",
		"build": "tsc && inject-version",
		"build:docs": "tsc -p tsconfig.docs.json",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions",
		"docs": "pnpm run build:docs && api-extractor run --local --minify && generate-split-documentation",
		"prepack": "pnpm run build && pnpm run lint",
		"changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r ../../ --include-path 'packages/core/*'",
		"release": "cliff-jumper"
	},
	"dependencies": {
		"@discordjs/rest": "workspace:^",
		"@discordjs/util": "workspace:^",
		"@discordjs/ws": "workspace:^",
		"@sapphire/snowflake": "^3.5.5",
		"@vladfrangu/async_event_emitter": "^2.4.7",
		"discord-api-types": "^0.38.54"
	},
	"devDependencies": {
		"@discordjs/api-extractor": "workspace:^",
		"@discordjs/scripts": "workspace:^",
		"@favware/cliff-jumper": "^6.1.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"turbo": "^2.10.12",
		"typescript": "~7.1.0-dev.20261003.1",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
