{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/actions",
	"version": "0.1.0",
	"private": true,
	"description": "A set of actions that we use for our workflows",
	"keywords": [
		"api",
		"bot",
		"client",
		"discordjs",
		"node"
	],
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "Apache-2.0",
	"contributors": [
		"Crawl <icrawltogo@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/actions"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"directories": {
		"lib": "src",
		"test": "__tests__"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"test": "vitest run --config ../../vitest.config.ts",
		"build": "tsc --noEmit --lib ESNext,DOM && tsup",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src __tests__",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src __tests__ --fix --fix-suggestions",
		"fmt": "pnpm run format"
	},
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"@actions/glob": "^0.6.1",
		"@aws-sdk/client-s3": "^3.1019.0",
		"@discordjs/scripts": "workspace:^",
		"cloudflare": "^5.2.0",
		"commander": "^14.0.3",
		"meilisearch": "^0.56.0",
		"p-limit": "^7.3.0",
		"p-queue": "^9.1.0",
		"tslib": "^2.8.1",
		"undici": "7.24.6"
	},
	"devDependencies": {
		"@npm/types": "^2.1.0",
		"@types/bun": "^1.3.11",
		"@types/node": "^24.13.2",
		"@vitest/coverage-v8": "^4.1.2",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"terser": "^5.46.1",
		"tsup": "^8.5.1",
		"turbo": "^2.8.21",
		"typescript": "~5.9.3",
		"vitest": "^4.1.2"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
