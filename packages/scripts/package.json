{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/scripts",
	"version": "0.1.0",
	"private": true,
	"description": "A set of scripts that we use for our workflows",
	"keywords": [
		"api",
		"bot",
		"client",
		"discordjs",
		"node"
	],
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "Apache-2.0",
	"contributors": [
		"Crawl <icrawltogo@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/scripts"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"bin": {
		"generate-split-documentation": "./bin/generateSplitDocumentation.js",
		"sort-labels": "./bin/sortLabels.js"
	},
	"directories": {
		"lib": "src",
		"bin": "bin",
		"example": "turbo"
	},
	"files": [
		"bin/generateSplitDocumentation.js",
		"dist"
	],
	"main": "./dist/src/index.js",
	"module": "./dist/src/index.mjs",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"import": {
				"types": "./dist/src/index.d.mts",
				"default": "./dist/src/index.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsc --noEmit --lib ESNext,DOM && tsup",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src turbo/generators/config.ts",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src turbo/generators/config.ts --fix --fix-suggestions",
		"fmt": "pnpm run format"
	},
	"dependencies": {
		"@actions/glob": "^0.6.1",
		"@discordjs/api-extractor-model": "workspace:^",
		"@discordjs/api-extractor-utils": "workspace:^",
		"@microsoft/tsdoc": "~0.16.0",
		"@microsoft/tsdoc-config": "~0.18.1",
		"@vercel/blob": "^2.3.2",
		"@vercel/postgres": "^0.10.0",
		"commander": "^14.0.3",
		"tslib": "^2.8.1",
		"undici": "7.24.6",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@turbo/gen": "^2.8.21",
		"@types/node": "^24.13.2",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"terser": "^5.46.1",
		"tsup": "^8.5.1",
		"turbo": "^2.8.21",
		"typescript": "~5.9.3"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
