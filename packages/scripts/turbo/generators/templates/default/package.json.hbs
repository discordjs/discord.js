{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/{{name}}",
	"version": "0.1.0",
	"description": "{{description}}",
	"keywords": [],
	"homepage": "https://discord.js.org",
	"bugs": {
		"url": "https://github.com/discordjs/discord.js/issues"
	},
	"license": "Apache-2.0",
	"contributors": [
		"Crawl <icrawltogo@gmail.com>",
		"SpaceEEC <spaceeec@yahoo.com>",
		"Vlad Frangu <me@vladfrangu.dev>",
		"Aura Román <kyradiscord@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/{{name}}"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"directories": {
		"lib": "src",
		"test": "__tests__"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc",
		"build:docs": "tsc -p tsconfig.docs.json",
		"test": "vitest run --config ../../vitest.config.ts",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions",
		"fmt": "pnpm run format",
		"docs": "pnpm run build:docs && api-extractor run --local",
		"prepack": "pnpm run build && pnpm run lint",
		"changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r ../../ --include-path 'packages/{{name}}/*'",
		"release": "cliff-jumper"
	},
	"dependencies": {},
	"devDependencies": {
		"@discordjs/api-extractor": "workspace:^",
		"@favware/cliff-jumper": "^6.1.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"turbo": "^2.10.12",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"typescript-native": "npm:typescript@~7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
