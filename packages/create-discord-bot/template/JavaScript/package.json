{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/template-javascript",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "oxfmt --check && oxlint src",
		"format": "oxfmt && oxlint src --fix --fix-suggestions",
		"start": "node --env-file=.env src/index.js",
		"deploy": "node --env-file=.env src/util/deploy.js"
	},
	"dependencies": {
		"@discordjs/core": "^2.4.0",
		"discord.js": "^14.25.1"
	},
	"devDependencies": {
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"zod": "^4.3.6"
	},
	"engines": {
		"node": ">=24.17.0"
	}
}
