{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@discordjs/template-bun-typescript",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "tsc && oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"deploy": "bun --env-file=.env src/util/deploy.ts",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions",
		"start": "bun --env-file=.env src/index.ts"
	},
	"dependencies": {
		"@discordjs/core": "^2.4.0",
		"discord.js": "^14.25.1"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.3",
		"@types/bun": "^1.3.11",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"typescript": "~5.9.3",
		"zod": "^4.3.6"
	}
}
