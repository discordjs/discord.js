{
	"name": "@discordjs/api-extractor",
	"version": "7.58.7",
	"private": true,
	"description": "Analyze the exported API for a TypeScript library and generate reviews, documentation, and .d.ts rollups",
	"keywords": [
		".d.ts",
		"AEDoc",
		"API",
		"JSDoc",
		"TSDoc",
		"alpha",
		"beta",
		"bundle",
		"compiler",
		"declaration",
		"documentation",
		"dts",
		"generate",
		"rollup",
		"typescript"
	],
	"homepage": "https://discord.js.org",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/discordjs/discord.js.git",
		"directory": "packages/api-extractor"
	},
	"funding": "https://github.com/discordjs/discord.js?sponsor",
	"bin": {
		"api-extractor": "./bin/api-extractor"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc && pnpm run copy-files",
		"copy-files": "cpy \"src/schemas/*.json\" \"dist/schemas\" && cpy \"extends/*.json\" \"dist/extends\"",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json src",
		"format": "oxfmt && oxlint --tsconfig=tsconfig.eslint.json src --fix --fix-suggestions"
	},
	"dependencies": {
		"@discordjs/api-extractor-model": "workspace:^",
		"@microsoft/tsdoc": "~0.17.1",
		"@microsoft/tsdoc-config": "~0.18.1",
		"@rushstack/node-core-library": "^5.23.1",
		"@rushstack/terminal": "^0.24.2",
		"@rushstack/ts-command-line": "^5.3.9",
		"diff": "~8.0.4",
		"resolve": "~1.22.12",
		"semver": "~7.7.4",
		"source-map": "~0.6.1",
		"typescript": "~7.1.0-dev.20261003.1"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/resolve": "^1.20.6",
		"@types/semver": "^7.8.0",
		"cpy-cli": "^7.0.0",
		"eslint-config-neon": "^0.5.4",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"terser": "^5.51.2",
		"turbo": "^2.10.12"
	}
}
